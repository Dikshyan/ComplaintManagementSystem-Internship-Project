# Server configuration
PORT=8080

# Database URI (e.g. mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/complaint-db

# JWT signing secret (use a secure random string in production)
JWT_SECRET=your-jwt-secret-key-change-me-in-production

# Cloudinary credentials for media upload
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Allowed CORS origins (comma-separated list for production)
# CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5173